{
  "card": "<card_name>",
  "robot": "<vendor-model>",
  "author": "<github-id>",
  "category": "sensor",
  "control_level": "ANY",
  "version": "1.0.0",
  "status": "draft",
  "topic": "<relative/topic>",
  "rate_hz": 10.0,
  "payload_fields": {
    "<field>": "<含义/单位>"
  },
