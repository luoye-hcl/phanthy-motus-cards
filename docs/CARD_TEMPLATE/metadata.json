    "topic_out": [ { "topic": "/{ns}/<relative/topic>", "format": "data/json" } ]
  },
  "source": {
    "repo": "<owner/repo>",
    "path": "<path/to/file.py>",
    "class": "<ClassName>",
    "commit": "<optional-commit-sha>"
  }
