          "description": "执行一个白名单预设动作。"
        },
        "cancel": {
          "params": [],
          "description": "请求取消正在执行的动作。"
        },
        "info": {
          "params": [],
          "description": "查看动作执行状态和安全条件。"
        }
      }
    },
