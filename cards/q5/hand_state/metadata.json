{
  "card": "hand_state",
  "robot": "q5",
  "author": "huangchanglong",
  "category": "sensor",
  "control_level": "HIGHLEVEL",
  "version": "1.0.0",
  "status": "draft",
  "topic": "/joint_states",
  "rate_hz": 10.0,
  "payload_fields": [
    "joint_names",
    "joint_count",
    "positions",
    "velocities",
    "efforts",
    "complete",
    "hand_model"
  ],
  "mcp_tool": {
    "name": "hand_state",
    "type": "sensor",
    "multiInstance": false,
    "readOnly": true,
    "description": "Q5 XHand Lite 左右手关节状态：位置、速度、力矩，用于查看灵巧手当前姿态",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "info",
            "start",
            "stop"
          ],
          "description": "读取当前状态(info)或控制卡片生命周期(start/stop)"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "topic_out": [
      {
        "topic": "/{ns}/q5/hand_state",
        "format": "data/json"
      }
    ]
  },
  "source": {
    "repo": "phanthymotus-driver",
    "path": "robotera/q5_bundle/hand_state.py",
    "class": "Plugin",
    "commit": null
  }
}