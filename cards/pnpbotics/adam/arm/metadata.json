{
  "card": "arm",
  "robot": "pnpbotics-adam",
  "author": "huangchanglong",
  "category": "actuator",
  "control_level": "HIGHLEVEL",
  "version": "1.0.0",
  "status": "draft",
  "topic": "joint_states",
  "rate_hz": 100,
  "payload_fields": ["joints", "height"],
  "mcp_tool": {
    "name": "arm",
    "type": "actuator",
    "multiInstance": false,
    "readOnly": false,
    "description": "控制 Adam 腰部、双臂、手腕和机身高度。仅在机器人站立且已进入上肢实时接收模式时使用。",
    "inputSchema": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["enable", "disable", "set_joints", "set_height", "zero"]
        },
        "joints": {
          "type": "object",
          "description": "关节名称到目标弧度值的映射"
        },
        "height": {
          "type": "number",
          "description": "机身目标高度 0.6-1.0m"
        }
      }
    },
    "x-action-params": {
      "enable": {"params": [], "description": "启用上肢实时控制"},
      "disable": {"params": [], "description": "停用上肢实时控制"},
      "set_joints": {"params": ["joints"], "description": "按关节名称设置目标弧度"},
      "set_height": {"params": ["height"], "description": "设置机身高度"},
      "zero": {"params": [], "description": "将上肢关节目标归零"}
    },
    "topic_out": [
      {"topic": "/{ns}/joint_states", "format": "sensor_msgs/JointState"}
    ]
  },
  "source": {
    "repo": "4paradigm/phanthymotus-driver",
    "path": "pndbotics/adam/device.py",
    "class": "ArmPlugin",
    "commit": "bc12e3f"
  }
}
